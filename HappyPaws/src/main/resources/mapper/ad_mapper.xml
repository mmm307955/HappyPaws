<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.happypaws.dao.AdDAO">

	 <!-- 관리자 아이디 조회 -->
    <select id="getAdminById" parameterType="String" resultType="com.happypaws.vo.AdVO">
        SELECT * FROM admin WHERE ad_id = #{ad_id}
    </select>
    
    <!-- 관리자 비밀번호 조회 -->
    <select id="getPasswordById" parameterType="String" resultType="com.happypaws.vo.AdVO">
        SELECT ad_password FROM admin WHERE ad_id = #{ad_id}
    </select>

    <!-- 비밀번호 업데이트 -->
    <update id="updatePassword" parameterType="map">
        UPDATE admin SET ad_password = #{ad_password} WHERE ad_id = #{ad_id}
    </update>

</mapper>
